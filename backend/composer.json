{
 "name": "courtmate/api", "type": "project", "description": "Stateless Laravel calculation API. No player database.",
 "require": { "php": "^8.3", "laravel/framework": "^13.17" },
 "autoload": { "psr-4": { "App\\": "app/" } },
 "scripts": { "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": "@php tests/run.php" },
 "config": { "sort-packages": true, "optimize-autoloader": true, "allow-plugins": {} }, "minimum-stability": "stable", "prefer-stable": true
}
