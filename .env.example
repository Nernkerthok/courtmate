# Default: guest mode. Cloud saves are enabled only when both Supabase values are set.
VITE_USE_API=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# true = POST to /api/settlements on the SAME origin. In dev, start Laravel on :8000.
# Production must reverse-proxy /api to Laravel. Never put secrets in VITE_* variables.
